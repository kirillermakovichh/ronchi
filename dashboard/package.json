{
  "name": "ronchi-dashboard",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/user-event": "^14.0.0",
    "jsdom": "^26.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "2.11.15",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "3.13.53",
    "@thisbeyond/solid-dnd": "0.7.5",
    "solid-js": "1.9.18"
  }
}
